{
  "extraKnownMarketplaces": {
    "equipe": {
      "source": {
        "source": "github",
        "repo": "fuforudude/agents-equipe"
      }
    }
  },
  "enabledPlugins": {
    "socle@equipe": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(lourd --etat)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git worktree*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)"
    ]
  }
}
